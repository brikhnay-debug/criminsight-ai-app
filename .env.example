# ─────────────────────────────────────────────────────────────
# CrimInsight AI — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# Supabase — found in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Reserved for future server-only routes that need to bypass RLS
# (e.g. admin document processing). NOT used yet, but never expose this
# to the browser or prefix it with NEXT_PUBLIC_ if you do use it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API — found at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional — defaults to gemini-1.5-flash if not set
GEMINI_MODEL=gemini-1.5-flash

# Public app URL (used for metadata, OAuth redirects, emails)
# Local dev:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (set this in Vercel):
# NEXT_PUBLIC_APP_URL=https://your-domain.com
